{
	"$schema": "https://json.schemastore.org/prettierrc",
	"printWidth": 120,
	"tabWidth": 2,
	"useTabs": true,
	"semi": false,
	"trailingComma": "all",
	"singleQuote": true,
	"bracketSpacing": true,
	"quoteProps": "consistent",
	"vueIndentScriptAndStyle": true,
	"plugins": ["prettier-plugin-tailwindcss"]
}
