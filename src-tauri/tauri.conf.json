{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "trano",
	"version": "0.1.0",
	"identifier": "com.alwaysemo.trano",
	"build": {
		"beforeDevCommand": "bun run dev",
		"devUrl": "http://localhost:3000",
		"beforeBuildCommand": "bun run build",
		"frontendDist": "../dist"
	},
	"app": {
		"macOSPrivateApi": true,
		"windows": [
			{
				"label": "input",
				"url": "input.html",
				"title": "输入翻译",
				"width": 380,
				"height": 600,
				"visible": false,
				"decorations": false,
				"transparent": true,
				"center": true
			},
			{
				"label": "screenshot",
				"url": "screenshot.html",
				"title": "截图翻译",
				"width": 360,
				"height": 600,
				"visible": false,
				"decorations": false,
				"transparent": true,
				"center": true
			},
			{
				"label": "selection",
				"url": "selection.html",
				"title": "划词翻译",
				"width": 360,
				"height": 600,
				"visible": false,
				"decorations": false,
				"transparent": true
			},
			{
				"label": "settings",
				"url": "settings.html",
				"title": "设置",
				"width": 800,
				"height": 600,
				"visible": false,
				"decorations": false,
				"transparent": true,
				"center": true
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
	},
	"plugins": {
		"updater": {
			"pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYxOTM4OTFDMDAzRDUzMTUKUldRVlV6MEFISW1UWWZCN1JVYXFUeCszMHRRT1I0ZVNWSC8vQlJaUzlzQ0JsMTh5M2hkbTRlY2oK",
			"endpoints": [
				"https://github.com/alwaysemo/translate/releases/latest/download/latest.json"
			]
		}
	}
}
